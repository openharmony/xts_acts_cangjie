declare_args() {
  acts_cangjie_build_mode = "test"
  acts_cangjie_hvigor = ""
}

acts_cangjie_root = "//test/xts/acts_cangjie"
acts_cangjie_output_dir = "${root_out_dir}/suites/acts_cangjie/testcases"

template("acts_cangjie_hvigor_hap") {
  assert(defined(invoker.project_dir), "project_dir is required")
  assert(defined(invoker.test_config), "test_config is required")
  assert(defined(invoker.hap_names), "hap_names is required")

  _project_dir = invoker.project_dir
  _test_config = invoker.test_config
  _hap_names = invoker.hap_names
  _stamp = "${target_out_dir}/${target_name}.stamp"
  _outputs = [ _stamp, "${acts_cangjie_output_dir}/${target_name}.Test.json" ]
  foreach(_hap, _hap_names) {
    _outputs += [ "${acts_cangjie_output_dir}/${_hap}.hap" ]
  }

  _args = [
    "--project-dir",
    rebase_path("${acts_cangjie_root}/${_project_dir}"),
    "--test-config",
    rebase_path("${acts_cangjie_root}/${_project_dir}/${_test_config}"),
    "--output-dir",
    rebase_path(acts_cangjie_output_dir),
    "--build-mode",
    acts_cangjie_build_mode,
    "--output-prefix",
    target_name,
    "--stamp",
    rebase_path(_stamp),
  ]
  if (acts_cangjie_hvigor != "") {
    _args += [ "--hvigorw", acts_cangjie_hvigor ]
  }
  if (defined(invoker.build_arkts) && invoker.build_arkts) {
    _args += [ "--build-arkts" ]
  }

  action(target_name) {
    testonly = true
    pool = "//test/xts/acts_cangjie:acts_cangjie_hvigor_pool"
    script = rebase_path("//test/xts/acts_cangjie/build/build_cangjie_hap.py")
    args = _args
    inputs = [
      rebase_path("${acts_cangjie_root}/${_project_dir}/${_test_config}"),
      rebase_path("${acts_cangjie_root}/${_project_dir}/build-profile.json5"),
      rebase_path("${acts_cangjie_root}/${_project_dir}/hvigorfile.ts"),
    ]
    outputs = _outputs
  }
}
