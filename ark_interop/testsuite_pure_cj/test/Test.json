{
  "description": "Configuration for cjTestpure_cj demo Tests",
  "driver": {
    "bundle-name": "com.example.pure_cj",
    "compile-mode":"esmodule",
    "module-name": "entry_test",
    "shell-timeout": "1000000",
    "test-timeout": "180000",
    "testcase-timeout": "180000",
    "type": "OHJSUnitTest"
  },
  "kits": [
    {
      "type": "AppInstallKit",
      "clean-apps": false,
      "test-file-name": [
        "cjTestpure_cj.hap",
        "cjTestpure_cj_ohostest.hap"
      ]
    },
    {
      "type": "ShellKit",
      "run-command": [
        "power-shell suspend",
        "power-shell wakeup",
        "power-shell timeout -o 99999999",
        "uinput -T -g 100 100 500 500"
      ],
      "teardown-command": [
        "bm uninstall -n com.example.pure_cj"
      ]
    }
  ]
}