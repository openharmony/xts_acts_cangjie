{
  "description": "Configuration for cjTestFlex_baseFunc1 demo Tests",
  "driver": {
    "bundle-name": "com.example.Flex_baseFunc1",
    "module-name": "entry",
    "shell-timeout": "600000",
    "test-timeout": "180000",
    "testcase-timeout": "180000",
    "type": "OHCJUnitTest"
  },
  "kits": [
    {
      "type": "AppInstallKit",
      "clean-apps": false,
      "test-file-name": [
        "cjTestFlex_baseFunc1.hap"
      ]
    },
    {
      "type": "ShellKit",
      "run-command": [
        "power-shell suspend",
        "power-shell wakeup",
        "power-shell timeout -o 99999999",
        "uinput -T -g 100 100 500 500"
      ],
      "teardown-command": [
        "bm uninstall -n com.example.Flex_baseFunc1"
      ]
    }
  ]
}
