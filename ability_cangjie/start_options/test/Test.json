{
  "description": "Configuration for cjTeststart_options demo Tests",
  "driver": {
    "bundle-name": "com.example.start_options",
    "module-name": "entry",
    "shell-timeout": "600000",
    "test-timeout": "180000",
    "testcase-timeout": "180000",
    "type": "OHCJUnitTest"
  },
  "kits": [
    {
      "type": "AppInstallKit",
      "clean-apps": false,
      "test-file-name": ["cjTeststart_options.hap"]
    },
    {
      "type": "ShellKit",
      "run-command": [
        "power-shell suspend",
        "power-shell wakeup",
        "uinput -T -g 100 100 500 500"
      ],
      "teardown-command":[
        "bm uninstall -n com.example.start_options"
      ]
    }
  ]
}